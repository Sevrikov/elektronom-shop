// Elektronom Shop — Prisma Schema
// MASTER_CONTEXT v1.3 §6
// PostgreSQL 16 + Prisma 7

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  MANAGER
  ADMIN
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

model User {
  id           String    @id @default(cuid(2))
  email        String    @unique
  name         String?
  phone        String?
  avatar       String?
  passwordHash String?
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  addresses    Address[]
  cartItems    CartItem[]
  wishlist     WishlistItem[]
  orders       Order[]
  reviews      Review[]
  assistantSessions AssistantSession[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid(2))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid(2))
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// USER DATA
// ─────────────────────────────────────────────

model Address {
  id          String  @id @default(cuid(2))
  userId      String
  label       String  @default("home") // home | work | other
  firstName   String
  lastName    String
  phone       String
  city        String
  street      String
  building    String
  apartment   String?
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid(2))
  slug      String   @unique
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]
  technicalDocuments TechnicalDocument[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model CategoryTranslation {
  id          String @id @default(cuid(2))
  categoryId  String
  locale      String // uk | ru
  name        String
  description String? @db.Text
  metaTitle   String?
  metaDesc    String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId])
  @@map("category_translations")
}

model Brand {
  id        String   @id @default(cuid(2))
  slug      String   @unique
  name      String
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]
  technicalDocuments TechnicalDocument[]

  @@index([slug])
  @@map("brands")
}

model Product {
  id           String   @id @default(cuid(2))
  slug         String   @unique
  sku          String   @unique
  categoryId   String
  brandId      String?
  price        Decimal  @db.Decimal(12, 2)
  comparePrice Decimal? @db.Decimal(12, 2)
  costPrice    Decimal? @db.Decimal(12, 2)
  stock        Int      @default(0)
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  attributes   Json     @default("{}")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id])
  brand        Brand?               @relation(fields: [brandId], references: [id])
  translations ProductTranslation[]
  images       ProductImage[]
  cartItems    CartItem[]
  wishlist     WishlistItem[]
  reviews      Review[]
  orderItems   OrderItem[]

  // ─── Google Shopping / Merchant Center ───
  gtin                  String?
  mpn                   String?
  condition             ProductCondition   @default(NEW)
  googleProductCategory String?
  itemGroupId           String?
  salePrice             Decimal?           @db.Decimal(12, 2)
  saleStartsAt          DateTime?
  saleEndsAt            DateTime?

  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@index([sku])
  @@index([isActive, isFeatured])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([isActive, sortOrder])
  @@index([categoryId, isActive])
  @@index([attributes], type: Gin)
  @@index([gtin])
  @@index([itemGroupId])
  @@map("products")
}

model ProductTranslation {
  id          String @id @default(cuid(2))
  productId   String
  locale      String // uk | ru
  name        String
  description String? @db.Text
  metaTitle   String?
  metaDesc    String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([productId])
  @@map("product_translations")
}

model ProductImage {
  id           String  @id @default(cuid(2))
  productId    String
  provider     String  @default("LOCAL") // CLOUDINARY | LOCAL | EXTERNAL
  publicId     String?
  url          String
  processedUrl String?
  originalUrl  String?
  width        Int?
  height       Int?
  format       String?
  size         Int?
  alt          String?
  sortOrder    Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─────────────────────────────────────────────
// REVIEWS & WISHLIST
// ─────────────────────────────────────────────

model Review {
  id               String   @id @default(cuid(2))
  productId        String
  userId           String
  rating           Int      // 1-5
  comment          String?  @db.Text
  advantages       String?  @db.Text
  disadvantages    String?  @db.Text
  verifiedPurchase Boolean  @default(false)
  isVisible        Boolean  @default(false)
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(cuid(2))
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ─────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid(2))
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD_ONLINE
  CASH_ON_DELIVERY
  MONOBANK_PARTS
  PRIVAT_PARTS
}

model Order {
  id            String        @id @default(cuid(2))
  number        String        @unique // ORD-YYYY-NNNNN
  userId        String?
  addressId     String?
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  shipping      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  customerData  Json          // snapshot: name, email, phone
  notes         String?       @db.Text
  idempotencyKey String?      @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  @@index([userId])
  @@index([number])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid(2))
  orderId   String
  productId String?
  snapshot  Json    // snapshot: name, sku, image, price at time of order
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderCounter {
  year  Int @id
  value Int @default(0)

  @@map("order_counters")
}

// ─────────────────────────────────────────────
// ASSISTANT & RAG MODELS
// ─────────────────────────────────────────────

model TechnicalDocument {
  id          String         @id @default(cuid(2))
  title       String
  fileUrl     String?
  fileType    String?        // PDF | TXT | DOCX
  content     String?        @db.Text
  categoryId  String?
  brandId     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  chunks      DocumentChunk[]
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand       Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([brandId])
  @@map("technical_documents")
}

model DocumentChunk {
  id          String            @id @default(cuid(2))
  documentId  String
  content     String            @db.Text
  embedding   String?           @db.Text // JSON-serialized float array representing OpenAI/Claude embedding
  createdAt   DateTime          @default(now())

  document    TechnicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

model AssistantSession {
  id          String             @id @default(cuid(2))
  userId      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages    AssistantMessage[]

  @@index([userId])
  @@map("assistant_sessions")
}

model AssistantMessage {
  id          String           @id @default(cuid(2))
  sessionId   String
  role        String           // USER | ASSISTANT
  content     String           @db.Text
  structured  Json?            // Recommended products, warnings, sources metadata
  feedback    String?          // HELPFUL | UNHELPFUL
  createdAt   DateTime         @default(now())

  session     AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("assistant_messages")
}

model SupplierInventory {
  id           String   @id @default(cuid(2))
  sku          String   @unique
  mpn          String?
  supplierSku  String?
  name         String
  stock        Int      @default(0)
  price        Decimal  @db.Decimal(12, 2)
  supplierName String
  updatedAt    DateTime @updatedAt

  @@index([sku])
  @@map("supplier_inventory")
}
