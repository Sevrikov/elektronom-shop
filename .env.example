# .env.example
# B-6: Синхронизировано с src/lib/env.ts (2026-05-31)
# Скопируй в .env и заполни значения

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/elektronom
# A-6: Для Vercel/serverless — добавить ?connection_limit=1&pool_timeout=20
# Или использовать Prisma Accelerate / PgBouncer (рекомендуется)
# DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/elektronom  # для prisma migrate

# ─── NextAuth v5 ───────────────────────────────────────────────────────────────
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=<replace-with-generated-secret>
AUTH_URL=http://localhost:3000

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Facebook OAuth ────────────────────────────────────────────────────────────
# https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# https://resend.com/ — ключ начинается с re_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@elektronom.com.ua

# ─── Payment ───────────────────────────────────────────────────────────────────
# A-1: провайдер — liqpay | fondy | wayforpay | monobank | portmone
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ─── Algolia ───────────────────────────────────────────────────────────────────
# ВАЖНО: ALGOLIA_ADMIN_KEY никогда не в NEXT_PUBLIC_*!
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# ─── Cloudinary (опционально — для загрузки изображений) ───────────────────────
# Если указан один — нужны все три
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AI Ассистент (опционально — деградирует без ключа) ────────────────────────
ANTHROPIC_API_KEY=

# ─── Content Factory (опционально — локальный dev-инструмент) ─────────────────
CONTENT_FACTORY_API_URL=http://127.0.0.1:8028
CONTENT_FACTORY_TOKEN=

# ─── E2E Testing ───────────────────────────────────────────────────────────────
E2E_TEST_SECRET=

# ─── Feature Flags (Alpha 1.2) ──────────────────────────────────────────────────
# All flags default to false if not set
alpha12_content_guides_enabled=false
alpha12_guide_rag_citations_enabled=false
alpha12_seo_answer_blocks_enabled=false
alpha12_article_schema_enabled=false
alpha12_faq_howto_schema_enabled=false
alpha12_trust_entity_enabled=false
alpha12_recently_viewed_enabled=false
alpha12_co_purchase_recommendations_enabled=false
alpha12_ai_recommendations_enabled=false
alpha12_bi_dashboard_enabled=false
alpha12_ab_experiments_enabled=false
